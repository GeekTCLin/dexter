# LLM API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
MOONSHOT_API_KEY=your-moonshot-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
# OpenCode Go gateway (OpenAI-compatible; glm-5.3, deepseek-v4.1-flash, kimi-k2.7-code, ...)
OPENCODE_API_KEY=your-opencode-go-api-key

# Ollama (Local LLM & Cloud)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CLOUD_API_KEY=your-ollama-cloud-api-key

# Persistent memory embeddings reuse existing model API keys.
# Priority (memory.embeddingProvider = "auto"):
#   OpenAI (OPENAI_API_KEY) -> Gemini (GOOGLE_API_KEY)
#   -> OpenAI-compatible (MEMORY_EMBEDDING_BASE_URL) -> Ollama (OLLAMA_BASE_URL)
# Placeholder values (empty or `your-...`) count as NOT configured.
# No additional memory-specific API keys required for the first two providers.

# Generic OpenAI-compatible embeddings provider (e.g. SiliconFlow, vLLM, LM Studio).
# Enabled only when MEMORY_EMBEDDING_BASE_URL is set; use memory.embeddingProvider
# = "openai-compatible" to force it, or leave "auto" to pick it after OpenAI/Gemini.
# MEMORY_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# MEMORY_EMBEDDING_API_KEY=your-openai-compatible-api-key
# MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
# Embedding request timeout (ms). Default 15000. Applies to all providers.
# MEMORY_EMBEDDING_TIMEOUT_MS=15000
# After a provider fails, skip it for this long (ms) and use keyword search.
# Default 30000.
# MEMORY_EMBEDDING_COOLDOWN_MS=30000

# Stock Market API Key
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# China Domestic Index Data (A-share indices) — no API key required.
# Optional overrides:
DOMESTIC_INDEX_PROVIDER=eastmoney
DOMESTIC_INDEX_TIMEOUT_MS=15000
# DOMESTIC_INDEX_UA=your-custom-user-agent

# Web Search
# Built-in keyless sources (no API key required): Bing (CN) and Baidu.
# The overseas providers below are optional supplementary/fallback sources.
EXASEARCH_API_KEY=your-exa-api-key
TAVILY_API_KEY=your-tavily-api-key
LANGSEARCH_API_KEY=your-langsearch-api-key
# DEPRECATED / disabled: Perplexity is unreachable from mainland networks and
# has been removed from the provider chain. The variable is kept only so old
# .env files don't break; it is no longer read.
PERPLEXITY_API_KEY=your-perplexity-api-key
# Web search tuning (optional):
# WEB_SEARCH_TIMEOUT_MS=15000
# WEB_SEARCH_UA=your-custom-user-agent
# WEB_SEARCH_DISABLED=1

# X/Twitter API (enables x_search tool for public sentiment research)
X_BEARER_TOKEN=your-X-bearer-token

# China Domestic News & Sentiment (A-share flash news, Guba sentiment, keyword
# news, CNINFO announcements) — no API key required, enabled by default.
# Set DOMESTIC_SEARCH_DISABLED=1 to turn the domestic_search tool off.
DOMESTIC_SEARCH_TIMEOUT_MS=15000
# DOMESTIC_SEARCH_UA=your-custom-user-agent
# DOMESTIC_SEARCH_DISABLED=1

# LangSmith 
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=dexter
LANGSMITH_TRACING=false
